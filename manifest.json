{
  "manifest_version": 3,
  "name": "tab-home",
  "version": "1.3.0",
  "description": "tab-home — custom favorites, live Chrome tab groups and bookmarks, system-aware themes, and open tabs by domain.",
  "permissions": ["tabs", "tabGroups", "activeTab", "storage", "contextMenus", "favicon"],
  "optional_permissions": ["bookmarks"],
  "host_permissions": ["<all_urls>"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "tab-home",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
